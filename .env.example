# ============================================
# SELEZIONE PROVIDER ATTIVO
# Valori ammessi: ollama | groq | openai
# ============================================
ACTIVE_PROVIDER=ollama

# ============================================
# 1. OLLAMA (Locale)
# ============================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_EMBEDDING_URL=http://localhost:11434/api/embeddings
OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:270m
OLLAMA_LLM_MODEL=bonsai-2:9b
OLLAMA_API_KEY=ollama

# ============================================
# 2. GROQ (Cloud)
# ============================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ============================================
# 3. OPENAI (Cloud)
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# STRATEGIA DI CHUNKING (02 - 05.HR_Assistant)
# Valori: semantic_chunking | semantic_sections | sliding_window | legacy
# ============================================
CHUNK_STRATEGY=semantic_chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

